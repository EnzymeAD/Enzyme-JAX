# Native Bazel build of libz3, replacing z3's CMake/rules_foreign_cc build.
#
# z3's own build systems (CMake and scripts/mk_make.py) both boil down to:
# compile every .cpp under src/ (minus tests, the z3 shell and the language
# bindings) into one library, plus a handful of files generated by the Python
# scripts in scripts/. We reuse those scripts verbatim, run on the hermetic
# Python toolchain, so this file only has to know *which* scripts exist, not
# what they do. Sources and headers are globbed, so bumping z3 is normally just
# a version/sha256 change in workspace.bzl.
#
# When bumping z3, diff the flags below against the top-level CMakeLists.txt
# ("Platform detection", "FP math", Z3_COMPONENT_CXX_DEFINES).

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

licenses(["notice"])

exports_files(["LICENSE.txt"])

# Directories under src/ that are not part of libz3.
_NOT_LIBZ3 = [
    "src/test/**",
    "src/shell/**",
    "src/api/c++/**",  # header-only; exported via `includes` below
    "src/api/dll/**",  # only holds the generated registration files (see below)
    "src/api/dotnet/**",
    "src/api/go/**",
    "src/api/java/**",
    "src/api/js/**",
    "src/api/julia/**",
    "src/api/mcp/**",
    "src/api/ml/**",
    "src/api/python/**",
]

################################################################################
# Generator scripts
################################################################################

py_library(
    name = "mk_genfile_common",
    srcs = ["scripts/mk_genfile_common.py"],
    imports = ["scripts"],
)

[
    py_binary(
        name = script,
        srcs = ["scripts/{}.py".format(script)],
        deps = [":mk_genfile_common"],
    )
    for script in [
        "mk_gparams_register_modules_cpp",
        "mk_install_tactic_cpp",
        "mk_mem_initializer_cpp",
        "mk_pat_db",
        "pyg2hpp",
        "update_api",
    ]
]

################################################################################
# Generated files
################################################################################

# src/util/z3_version.h from scripts/VERSION.txt ("MAJOR.MINOR.PATCH.TWEAK").
genrule(
    name = "z3_version_h",
    srcs = ["scripts/VERSION.txt"],
    outs = ["src/util/z3_version.h"],
    cmd = """
v=$$(tr -d '[:space:]' < $<)
set -- $$(echo "$$v" | tr . ' ')
cat > $@ <<EOF
// automatically generated file.
#define Z3_MAJOR_VERSION   $${1:-0}
#define Z3_MINOR_VERSION   $${2:-0}
#define Z3_BUILD_NUMBER    $${3:-0}
#define Z3_REVISION_NUMBER $${4:-0}

#define Z3_FULL_VERSION    "$$v"
/* #undef Z3GITHASH */
EOF
""",
)

# Parameter descriptions: each foo.pyg becomes foo.hpp next to it.
_PYG_FILES = glob(["src/**/*.pyg"])

[
    genrule(
        name = pyg[:-len(".pyg")].replace("/", "_") + "_hpp",
        srcs = [pyg],
        outs = [pyg[:-len(".pyg")] + ".hpp"],
        cmd = "$(location :pyg2hpp) $< $(@D)",
        tools = [":pyg2hpp"],
    )
    for pyg in _PYG_FILES
]

_PYG_HEADERS = [pyg[:-len(".pyg")] + ".hpp" for pyg in _PYG_FILES]

# Pattern database for the SMT pattern inference.
genrule(
    name = "database_h",
    srcs = ["src/ast/pattern/database.smt2"],
    outs = ["src/ast/pattern/database.h"],
    cmd = "$(location :mk_pat_db) $< $@",
    tools = [":mk_pat_db"],
)

# C API logging/replay glue, generated from the public API headers. Same list
# as Z3_API_HEADER_FILES_TO_SCAN in z3's CMakeLists.txt.
genrule(
    name = "api_generated",
    srcs = [
        "src/api/z3_api.h",
        "src/api/z3_ast_containers.h",
        "src/api/z3_algebraic.h",
        "src/api/z3_polynomial.h",
        "src/api/z3_rcf.h",
        "src/api/z3_fixedpoint.h",
        "src/api/z3_optimization.h",
        "src/api/z3_fpa.h",
        "src/api/z3_spacer.h",
    ],
    outs = [
        "src/api/api_commands.cpp",
        "src/api/api_log_macros.cpp",
        "src/api/api_log_macros.h",
    ],
    cmd = "$(location :update_api) $(SRCS) --api_output_dir $(RULEDIR)/src/api",
    tools = [":update_api"],
)

# Registration tables (tactics/probes/simplifiers, memory initializers and
# parameter modules) are produced by scanning headers for ADD_TACTIC(...),
# ADD_INITIALIZER(...), REG_PARAMS(...) etc. z3's CMake scans the headers each
# component lists explicitly; we scan every header in the library instead, which
# yields the same tables (modulo headers upstream forgot to list) and needs no
# per-component bookkeeping.
_SCANNED_HEADERS = glob(
    ["src/**/*.h"],
    exclude = _NOT_LIBZ3,
) + _PYG_HEADERS

genrule(
    name = "install_tactic_cpp",
    srcs = _SCANNED_HEADERS,
    outs = ["src/api/dll/install_tactic.cpp"],
    cmd = """
deps=$(RULEDIR)/src/api/dll/install_tactic.deps
mkdir -p $(@D)
echo $(SRCS) | tr ' ' '\\n' > $$deps
$(location :mk_install_tactic_cpp) $(@D) $$deps
rm -f $$deps
""",
    tools = [":mk_install_tactic_cpp"],
)

genrule(
    name = "mem_initializer_cpp",
    srcs = _SCANNED_HEADERS,
    outs = ["src/api/dll/mem_initializer.cpp"],
    cmd = "mkdir -p $(@D) && $(location :mk_mem_initializer_cpp) $(@D) $(SRCS)",
    tools = [":mk_mem_initializer_cpp"],
)

genrule(
    name = "gparams_register_modules_cpp",
    srcs = _SCANNED_HEADERS,
    outs = ["src/api/dll/gparams_register_modules.cpp"],
    cmd = "mkdir -p $(@D) && $(location :mk_gparams_register_modules_cpp) $(@D) $(SRCS)",
    tools = [":mk_gparams_register_modules_cpp"],
)

################################################################################
# libz3
################################################################################

cc_library(
    name = "z3",
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = _NOT_LIBZ3,
    ) + [
        "src/api/api_commands.cpp",
        "src/api/api_log_macros.cpp",
        "src/api/dll/gparams_register_modules.cpp",
        "src/api/dll/install_tactic.cpp",
        "src/api/dll/mem_initializer.cpp",
    ],
    hdrs = glob(
        [
            "src/**/*.h",
            "src/**/*.def",
            "src/api/c++/*.h",
        ],
        exclude = [e for e in _NOT_LIBZ3 if e != "src/api/c++/**"],
    ) + _PYG_HEADERS + [
        "src/api/api_log_macros.h",
        "src/ast/pattern/database.h",
        "src/util/z3_version.h",
    ],
    copts = [
        # z3 requires C++20 (CMAKE_CXX_STANDARD 20); this must win over any
        # -std= passed via --cxxopt.
        "-std=c++20",
        "-D_MP_INTERNAL",  # Z3_USE_LIB_GMP=OFF
        "-D_EXTERNAL_RELEASE",  # CMAKE_BUILD_TYPE=Release
        "-w",
        # std::format fallback for toolchains without it (added by
        # std_format_shim.patch; resolved through the `src` include path).
        "-include",
        "util/z3_std_format.h",
    ] + select({
        # z3 relies on SSE2 for deterministic floating point on x86.
        "@platforms//cpu:x86_64": [
            "-mfpmath=sse",
            "-msse",
            "-msse2",
        ],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:windows": [
            "-D_WINDOWS",
            "-D_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR",
        ],
        "//conditions:default": [],
    }),
    includes = [
        "src",
        "src/api",
        "src/api/c++",
    ],
    linkopts = select({
        "@platforms//os:windows": ["-ldbghelp"],
        "//conditions:default": ["-pthread"],
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "z3_static",
    actual = ":z3",
    visibility = ["//visibility:public"],
)
