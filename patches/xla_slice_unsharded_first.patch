diff --git a/xla/service/spmd/spmd_partitioner.cc b/xla/service/spmd/spmd_partitioner.cc
--- a/xla/service/spmd/spmd_partitioner.cc
+++ b/xla/service/spmd/spmd_partitioner.cc
@@ -3082,9 +3082,65 @@
         nullptr, PartitionedHlo(nullptr, shape, poperand.state()));
   }
 
-  auto reshard_operand =
-      ReshardDataForSlicing(slice_strides, slice_starts, slice_limits,
-                            poperand.Reshard(sharding), sharding, b);
+  // The halo exchange that moving the window along a sharded dimension
+  // needs is of the whole operand, and the slice of the other dimensions
+  // only comes after it. Along the dimensions that are not sharded, every
+  // device holds the whole extent, so that slice costs nothing: take it
+  // first, and exchange the halo of the slab instead. Only done with
+  // xla_enable_enzyme_comms_opt.
+  PartitionedHlo operand = poperand.Reshard(sharding);
+  std::vector<int64_t> starts(slice_starts.begin(), slice_starts.end());
+  std::vector<int64_t> limits(slice_limits.begin(), slice_limits.end());
+  const HloModule* module = operand.state().module;
+  const bool enzyme_comms_opt =
+      module != nullptr &&
+      module->config().debug_options().xla_enable_enzyme_comms_opt();
+  bool sharded_window = false;
+  if (enzyme_comms_opt && sharding.IsTiled() && operand.hlo() != nullptr) {
+    const Shape& base = operand.base_shape();
+    for (int64_t d = 0; d < base.dimensions().size(); ++d) {
+      if (sharding.NumTiles({d}) != 1 &&
+          (starts[d] != 0 || limits[d] != base.dimensions(d) ||
+           slice_strides[d] != 1)) {
+        sharded_window = true;
+      }
+    }
+  }
+  if (sharded_window) {
+    const Shape& base = operand.base_shape();
+    const Shape& local = operand.hlo()->shape();
+    Shape narrowed_base = base;
+    Shape narrowed_local = local;
+    std::vector<int64_t> local_starts(base.dimensions().size(), 0);
+    std::vector<int64_t> local_limits(local.dimensions().begin(),
+                                      local.dimensions().end());
+    std::vector<int64_t> local_strides(base.dimensions().size(), 1);
+    bool narrow = false;
+    for (int64_t d = 0; d < base.dimensions().size(); ++d) {
+      if (sharding.NumTiles({d}) != 1 || slice_strides[d] != 1 ||
+          local.dimensions(d) != base.dimensions(d) ||
+          (starts[d] == 0 && limits[d] == base.dimensions(d))) {
+        continue;
+      }
+      local_starts[d] = starts[d];
+      local_limits[d] = limits[d];
+      narrowed_base.set_dimensions(d, limits[d] - starts[d]);
+      narrowed_local.set_dimensions(d, limits[d] - starts[d]);
+      limits[d] -= starts[d];
+      starts[d] = 0;
+      narrow = true;
+    }
+    if (narrow) {
+      HloInstruction* slab = b->AddInstruction(HloInstruction::CreateSlice(
+          narrowed_local, operand.hlo(), local_starts, local_limits,
+          local_strides));
+      slab->set_sharding(sharding);
+      operand = PartitionedHlo(slab, narrowed_base, operand.state());
+    }
+  }
+
+  auto reshard_operand = ReshardDataForSlicing(slice_strides, starts, limits,
+                                               operand, sharding, b);
   if (!reshard_operand.has_value()) {
     return std::pair<HloInstruction*, PartitionedHlo>(
         nullptr, PartitionedHlo(nullptr, shape, poperand.state()));
