+constexpr absl::string_view kSliceUnshardedFirstHlo = R"(
+HloModule module
+
+ENTRY entry {
+  %p = f32[20,16,8] parameter(0), sharding={devices=[1,2,1]<=[2]}
+  ROOT %s = f32[4,14,8] slice(%p), slice={[8:12], [2:16], [0:8]},
+    sharding={devices=[1,2,1]<=[2]}
+})";
+
+// Returns the number of collective-permutes in the entry computation, checking
+// that each one has the given extent along dimension 0.
+int CountCollectivePermutesWithDim0(const HloModule& module, int64_t dim0) {
+  int permutes = 0;
+  for (const HloInstruction* instr :
+       module.entry_computation()->instructions()) {
+    if (instr->opcode() != HloOpcode::kCollectivePermute) {
+      continue;
+    }
+    ++permutes;
+    EXPECT_EQ(instr->shape().dimensions(0), dim0) << instr->ToString();
+  }
+  return permutes;
+}
+
+TEST_P(SpmdPartitioningTest, SliceTakesUnshardedDimensionsFirstWithEnzymeOpt) {
+  // Four levels of a twenty-level field, read shifted along the sharded
+  // dimension: the halo exchanged is of the four levels, not of the field.
+  TF_ASSERT_OK_AND_ASSIGN(auto module,
+                          PartitionComputation(kSliceUnshardedFirstHlo,
+                                               /*num_devices=*/2,
+                                               SpmdPartitionerOptions(),
+                                               /*enable_enzyme_opt=*/true));
+  EXPECT_GT(CountCollectivePermutesWithDim0(*module, 4), 0);
+}
+
+TEST_P(SpmdPartitioningTest, SliceExchangesWholeOperandWithoutEnzymeOpt) {
+  // Without xla_enable_enzyme_comms_opt the partitioner is unchanged: the
+  // halo exchange is of the whole operand.
+  TF_ASSERT_OK_AND_ASSIGN(auto module,
+                          PartitionComputation(kSliceUnshardedFirstHlo,
+                                               /*num_devices=*/2));
+  EXPECT_GT(CountCollectivePermutesWithDim0(*module, 20), 0);
+}
