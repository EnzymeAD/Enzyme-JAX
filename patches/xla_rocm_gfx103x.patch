diff --git a/xla/stream_executor/rocm/rocm_compute_capability_test.cc b/xla/stream_executor/rocm/rocm_compute_capability_test.cc
--- a/xla/stream_executor/rocm/rocm_compute_capability_test.cc
+++ b/xla/stream_executor/rocm/rocm_compute_capability_test.cc
@@ -42,5 +42,18 @@ TEST(RocmComputeCapabilityTest, ToProto) {
                                 R"pb(gcn_arch_name: "gfx1010:xnack-")pb"));
 }
 
+TEST(RocmComputeCapabilityTest, SupportsGfx103Family) {
+  for (absl::string_view gfx :
+       {"gfx1030", "gfx1031", "gfx1032", "gfx1033", "gfx1034", "gfx1035",
+        "gfx1036"}) {
+    RocmComputeCapability cc{std::string(gfx)};
+    EXPECT_TRUE(cc.is_supported_gfx_version()) << gfx;
+    EXPECT_TRUE(cc.has_fast_fp16_support()) << gfx;
+    EXPECT_FALSE(cc.has_bf16_dtype_support()) << gfx;
+    EXPECT_FALSE(cc.has_hipblaslt()) << gfx;
+    EXPECT_EQ(cc.threads_per_warp(), 32) << gfx;
+  }
+}
+
