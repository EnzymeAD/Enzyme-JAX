+bool hasNonSingletonOrShardedNeedReplicationFactors(
+    const ShardingProjection& shardingProjection,
+    OpShardingRuleAttr shardingRule) {
+  ArrayRef<int64_t> factorSizes = shardingRule.getFactorSizes();
+  return llvm::any_of(
+      shardingRule.getNeedReplicationFactors(), [&](int64_t factorIndex) {
+        if (factorSizes[factorIndex] != 1) {
+          return true;
+        }
+        std::optional<ArrayRef<AxisRefAttr>> compatibleSharding =
+            getCompatibleFactorSharding(shardingProjection, factorIndex);
+        return !compatibleSharding || !compatibleSharding->empty();
+      });
+}
