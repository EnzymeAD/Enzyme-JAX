+// Returns true if `bcast` only inserts size-1 dimensions without expanding any
+// input dimension or permuting dimension order.
+bool isSingletonBroadcastInDim(stablehlo::BroadcastInDimOp bcast) {
+  auto inType = dyn_cast<RankedTensorType>(bcast.getOperand().getType());
+  auto outType = dyn_cast<RankedTensorType>(bcast.getType());
+  if (!inType || !outType || !inType.hasStaticShape() ||
+      !outType.hasStaticShape()) {
+    return false;
+  }
+  ArrayRef<int64_t> bcastDims = bcast.getBroadcastDimensions();
+  if (!llvm::is_sorted(bcastDims)) {
+    return false;
+  }
+  int64_t bcastIdx = 0;
+  for (int64_t outDim = 0; outDim < outType.getRank(); ++outDim) {
+    if (bcastIdx < static_cast<int64_t>(bcastDims.size()) &&
+        bcastDims[bcastIdx] == outDim) {
+      if (inType.getDimSize(bcastIdx) != outType.getDimSize(outDim)) {
+        return false;
+      }
+      ++bcastIdx;
+    } else if (outType.getDimSize(outDim) != 1) {
+      return false;
+    }
+  }
+  return bcastIdx == inType.getRank();
+}
