+// Maps `sharding` on the result of a singleton-inserting `BroadcastInDimOp`
+// back to its operand, or returns nullptr if any inserted singleton dimension
+// is sharded.
+TensorShardingAttr mapShardingAcrossSingletonBroadcastInDim(
+    TensorShardingAttr sharding, stablehlo::BroadcastInDimOp bcast) {
+  auto outType = dyn_cast<RankedTensorType>(bcast.getType());
+  if (!outType || sharding.getRank() != outType.getRank()) {
+    return nullptr;
+  }
+  ArrayRef<int64_t> bcastDims = bcast.getBroadcastDimensions();
+  SmallVector<DimensionShardingAttr> newDims;
+  newDims.reserve(bcastDims.size());
+  int64_t bcastIdx = 0;
+  for (int64_t outDim = 0; outDim < outType.getRank(); ++outDim) {
+    if (bcastIdx < static_cast<int64_t>(bcastDims.size()) &&
+        bcastDims[bcastIdx] == outDim) {
+      newDims.push_back(sharding.getDimShardings()[outDim]);
+      ++bcastIdx;
+    } else if (!sharding.getDimShardings()[outDim].emptyAxes()) {
+      return nullptr;
+    }
+  }
+  return TensorShardingAttr::get(
+      sharding.getContext(), sharding.getMeshOrRef(), newDims,
+      sharding.getReplicatedAxes(), sharding.getUnreducedAxes(),
+      sharding.getReductionOp());
+}
+
+// Maps `sharding` on the result of a `ReshapeOp` that only inserts or deletes
+// singleton dimensions back to its operand, or returns nullptr if `reshape`
+// splits/merges non-singleton dimensions or shards a dropped/ambiguous
+// singleton dimension.
+TensorShardingAttr mapShardingAcrossSingletonReshape(
+    TensorShardingAttr sharding, stablehlo::ReshapeOp reshape) {
+  auto inType = dyn_cast<RankedTensorType>(reshape.getOperand().getType());
+  auto outType = dyn_cast<RankedTensorType>(reshape.getType());
+  if (!inType || !outType || !inType.hasStaticShape() ||
+      !outType.hasStaticShape() || sharding.getRank() != outType.getRank()) {
+    return nullptr;
+  }
+  ArrayRef<int64_t> inShape = inType.getShape();
+  ArrayRef<int64_t> outShape = outType.getShape();
+  int64_t inRank = inShape.size();
+  int64_t outRank = outShape.size();
+  SmallVector<int64_t> inToOut(inRank, -1);
+  int64_t i = 0;
+  int64_t j = 0;
+  while (i < inRank || j < outRank) {
+    if (i < inRank && j < outRank && inShape[i] == outShape[j]) {
+      if (outShape[j] == 1 && !sharding.getDimShardings()[j].emptyAxes() &&
+          ((i + 1 < inRank && inShape[i + 1] == 1) ||
+           (j + 1 < outRank && outShape[j + 1] == 1))) {
+        return nullptr;
+      }
+      inToOut[i] = j;
+      ++i;
+      ++j;
+    } else if (j < outRank && outShape[j] == 1) {
+      if (!sharding.getDimShardings()[j].emptyAxes()) {
+        return nullptr;
+      }
+      ++j;
+    } else if (i < inRank && inShape[i] == 1) {
+      ++i;
+    } else {
+      return nullptr;
+    }
+  }
+  auto emptyDim = DimensionShardingAttr::get(sharding.getContext(),
+                                             /*axes=*/{}, /*isClosed=*/true);
+  SmallVector<DimensionShardingAttr> newDims;
+  newDims.reserve(inRank);
+  for (int64_t d = 0; d < inRank; ++d) {
+    newDims.push_back(inToOut[d] >= 0 ? sharding.getDimShardings()[inToOut[d]]
+                                      : emptyDim);
+  }
+  return TensorShardingAttr::get(
+      sharding.getContext(), sharding.getMeshOrRef(), newDims,
+      sharding.getReplicatedAxes(), sharding.getUnreducedAxes(),
+      sharding.getReductionOp());
 }
 
