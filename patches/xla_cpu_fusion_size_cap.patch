+namespace {
+
+int64_t Int64OptionOr(const HloModuleConfig& config, absl::string_view key,
+                      int64_t default_value) {
+  const auto& extra_options_map =
+      config.debug_options().xla_backend_extra_options();
+  auto it = extra_options_map.find(key);
+  if (it == extra_options_map.end()) {
+    return default_value;
+  }
+  int64_t value;
+  CHECK(absl::SimpleAtoi(it->second, &value))
+      << "Not an integer: " << key << "=" << it->second;
+  return value;
+}
+
+}  // namespace
+
+int64_t MaxFusionOperands(const HloModuleConfig& config) {
+  return Int64OptionOr(config, kMaxFusionOperands, 48);
+}
+
+int64_t MaxFusedInstructions(const HloModuleConfig& config) {
+  return Int64OptionOr(config, kMaxFusedInstructions, 512);
+}
