+    if (max_fusion_operands_ > 0 &&
+        OperandCountAfterFusing(consumer, producer) > max_fusion_operands_) {
+      return FusionDecision::Forbid(
+          "Not fusing: fusion would exceed the operand budget "
+          "(xla_cpu_max_fusion_operands).");
+    }
+    if (max_fused_instructions_ > 0 &&
+        FusedInstructionCountAfterFusing(consumer, producer) >
+            max_fused_instructions_) {
+      return FusionDecision::Forbid(
+          "Not fusing: fusion would exceed the fused-instruction budget "
+          "(xla_cpu_max_fused_instructions).");
+    }
+  }
