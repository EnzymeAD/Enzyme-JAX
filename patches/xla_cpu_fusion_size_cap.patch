+// The number of distinct operands `fusion` would have after fusing `producer`
+// into it: its current operands minus the producer itself, plus every producer
+// operand that is not already an operand of the fusion.
+int64_t OperandCountAfterFusing(const HloInstruction* fusion,
+                                const HloInstruction* producer) {
+  int64_t count = 0;
+  for (const HloInstruction* operand : fusion->operands()) {
+    if (operand != producer) {
+      ++count;
+    }
+  }
+  for (const HloInstruction* operand : producer->unique_operands()) {
+    if (!absl::c_linear_search(fusion->operands(), operand)) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+// The number of fused instructions `fusion` would have after fusing
+// `producer` into it. When the producer is itself a fusion its whole body is
+// inlined; otherwise one instruction is added.
+int64_t FusedInstructionCountAfterFusing(const HloInstruction* fusion,
+                                         const HloInstruction* producer) {
+  int64_t added = 1;
+  if (producer->opcode() == HloOpcode::kFusion) {
+    added = producer->fused_instruction_count();
+  }
+  return fusion->fused_instruction_count() + added;
+}
