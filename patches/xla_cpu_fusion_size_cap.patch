+absl::StatusOr<int64_t> MaxFusedInstructions(const HloModuleConfig& config) {
+  const auto& extra_options_map =
+      config.debug_options().xla_backend_extra_options();
+  auto it = extra_options_map.find(kMaxFusedInstructions);
+  if (it == extra_options_map.end()) {
+    return 512;  // Default value.
+  }
+  int64_t max_instructions;
+  if (!absl::SimpleAtoi(it->second, &max_instructions)) {
