+  )";
+  constexpr absl::string_view kKernel = R"(
+    declare <4 x double> @xla.atan.v4f64(<4 x double>)
+
+    define <4 x double> @kernel(<4 x double> %x) #0 {
+      %r = call <4 x double> @xla.atan.v4f64(<4 x double> %x)
+      ret <4 x double> %r
