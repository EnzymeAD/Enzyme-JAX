+    constexpr float kClamp = 7.90738964080810547f;
+    constexpr float kAlpha[] = {1.394553628e-8f, 2.102733560e-5f,
+                                3.520756727e-3f, 1.340216100e-1f};
+    constexpr float kBeta[] = {8.015776984e-7f, 3.326951409e-4f,
+                               2.597254514e-2f, 4.673548340e-1f, 1.0f};
+    const VecType plus_clamp = Splat<VecType>(kClamp);
+    const VecType minus_clamp = Splat<VecType>(-kClamp);
+    const VecType x_min = plus_clamp < a_x ? plus_clamp : a_x;
+    const VecType x = minus_clamp > x_min ? minus_clamp : x_min;
+    const VecType x2 = x * x;
+    const VecType x3 = x2 * x;
+    VecType p = Splat<VecType>(kAlpha[0]);
+    for (int i = 1; i < 4; ++i) {
+      p = p * x2 + Splat<VecType>(kAlpha[i]);
+    }
+    VecType q = Splat<VecType>(kBeta[0]);
+    for (int i = 1; i < 5; ++i) {
+      q = q * x2 + Splat<VecType>(kBeta[i]);
+    }
+    p = x3 * p + x;
+    return p / q;
