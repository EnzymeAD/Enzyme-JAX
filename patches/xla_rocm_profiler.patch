 void __attribute__((constructor)) init_rocm_lib() {
+#if defined(__linux__)
+  // Host libraries (such as libReactantExtra.so in Julia JLLs) are often
+  // dlopen'd with RTLD_LOCAL. Promote rocprofiler-register and rocprofiler-sdk
+  // to RTLD_GLOBAL before forcing configuration so rocprofiler-register can
+  // resolve rocprofiler_set_api_table via RTLD_DEFAULT across ROCm versions.
+  for (const char* soname :
+       {"librocprofiler-register.so.0", "librocprofiler-sdk.so.1"}) {
+    (void)dlopen(soname, RTLD_NOLOAD | RTLD_LAZY | RTLD_GLOBAL);
+  }
+#endif
   rocprofiler_force_configure(xla::profiler::rocprofiler_configure);
 }
