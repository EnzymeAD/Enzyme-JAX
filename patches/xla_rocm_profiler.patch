diff --git a/xla/backends/profiler/gpu/rocm_collector_test.cc b/xla/backends/profiler/gpu/rocm_collector_test.cc
index 5243b94..d90b131 100644
--- a/xla/backends/profiler/gpu/rocm_collector_test.cc
+++ b/xla/backends/profiler/gpu/rocm_collector_test.cc
@@ -404,6 +404,101 @@ TEST(RocmCollectorTest, MarkerAndApiEventsOnSameThreadGetSeparateLines) {
       << "the API event must stay on the plain host-thread line";
 }
 
+// Regression test: on APU/multi-socket nodes (e.g. MI300A), GPU agent handles
+// are offset by CPU agents (e.g. handle = 6 while num_gpus = 1), whereas
+// host-side MemcpyOther / Synchronization events carry device_id = 0 or
+// kInvalidDeviceId. Host events must not pull min_device_id down to 0 and
+// cause GPU kernel events to be dropped as out-of-range.
+TEST(RocmCollectorTest, HostZeroDeviceIdDoesNotDropCpuOffsetGpuKernelEvents) {
+  RocmTraceCollectorOptions options;
+  options.max_callback_api_events = 100;
+  options.max_activity_api_events = 100;
+  options.max_annotation_strings = 100;
+  options.num_gpus = 1;
+
+  RocmTraceCollectorImpl collector(options, /*start_walltime_ns=*/1000,
+                                   /*start_gputime_ns=*/2000);
+  rocprofiler_agent_v0_t gpu_agent{};
+  gpu_agent.id.handle = 6;
+  collector.SetGpuAgents({gpu_agent});
+
+  // 1. Host-to-host MemcpyOther event with device_id = 0.
+  constexpr uint32_t kMemcpyCorrId = 10;
+  RocmTracerEvent memcpy_api;
+  memcpy_api.type = RocmTracerEventType::MemcpyOther;
+  memcpy_api.source = RocmTracerEventSource::ApiCallback;
+  memcpy_api.domain = RocmTracerEventDomain::HIP_API;
+  memcpy_api.name = "hipMemcpy";
+  memcpy_api.correlation_id = kMemcpyCorrId;
+  memcpy_api.thread_id = 101;
+  memcpy_api.device_id = 0;
+  memcpy_api.start_time_ns = 2500;
+  memcpy_api.end_time_ns = 2600;
+  memcpy_api.memcpy_info = MemcpyDetails{64, 0, false};
+  collector.AddEvent(std::move(memcpy_api), /*is_auxiliary=*/false);
+
+  RocmTracerEvent memcpy_act;
+  memcpy_act.type = RocmTracerEventType::MemcpyOther;
+  memcpy_act.source = RocmTracerEventSource::Activity;
+  memcpy_act.domain = RocmTracerEventDomain::HIP_OPS;
+  memcpy_act.name = "hipMemcpy";
+  memcpy_act.correlation_id = kMemcpyCorrId;
+  memcpy_act.device_id = 0;
+  memcpy_act.stream_id = 1;
+  memcpy_act.start_time_ns = 2510;
+  memcpy_act.end_time_ns = 2590;
+  memcpy_act.memcpy_info = MemcpyDetails{64, 0, false};
+  collector.AddEvent(std::move(memcpy_act), /*is_auxiliary=*/false);
+
+  // 2. GPU kernel event on agent handle 6.
+  constexpr uint32_t kKernelCorrId = 11;
+  RocmTracerEvent kernel_api;
+  kernel_api.type = RocmTracerEventType::Kernel;
+  kernel_api.source = RocmTracerEventSource::ApiCallback;
+  kernel_api.domain = RocmTracerEventDomain::HIP_API;
+  kernel_api.name = "hipLaunchKernel";
+  kernel_api.correlation_id = kKernelCorrId;
+  kernel_api.thread_id = 101;
+  kernel_api.start_time_ns = 3000;
+  kernel_api.end_time_ns = 3100;
+  kernel_api.kernel_info = KernelDetails{};
+  collector.AddEvent(std::move(kernel_api), /*is_auxiliary=*/false);
+
+  RocmTracerEvent kernel_act;
+  kernel_act.type = RocmTracerEventType::Kernel;
+  kernel_act.source = RocmTracerEventSource::Activity;
+  kernel_act.domain = RocmTracerEventDomain::HIP_OPS;
+  kernel_act.name = "mi300a_gemm_kernel";
+  kernel_act.correlation_id = kKernelCorrId;
+  kernel_act.device_id = 6;
+  kernel_act.stream_id = 2;
+  kernel_act.start_time_ns = 3050;
+  kernel_act.end_time_ns = 4050;
+  kernel_act.kernel_info = KernelDetails{};
+  collector.AddEvent(std::move(kernel_act), /*is_auxiliary=*/false);
+
+  collector.Flush();
+  XSpace space;
+  collector.Export(&space);
+
+  const auto* gpu_plane =
+      FindOrAddMutablePlaneWithName(&space, "/device:GPU:0");
+  ASSERT_NE(gpu_plane, nullptr);
+
+  bool found_kernel = false;
+  for (const auto& line : gpu_plane->lines()) {
+    for (const auto& ev : line.events()) {
+      if (gpu_plane->event_metadata().at(ev.metadata_id()).name() ==
+          "mi300a_gemm_kernel") {
+        found_kernel = true;
+      }
+    }
+  }
+  EXPECT_TRUE(found_kernel)
+      << "GPU kernel event with CPU-offset agent handle must not be dropped "
+         "when device_id=0 events are present";
+}
+
 }  // namespace test
 }  // namespace profiler
 }  // namespace xla
