+                       PartitionComputation(hlo_string, /*num_devices=*/4));
+  const HloComputation* entry = module->entry_computation();
+  EXPECT_EQ(NumOfInstructions(entry, HloOpcode::kAllGather), 0);
+  EXPECT_EQ(NumOfInstructions(entry, HloOpcode::kAllReduce), 0);
+  EXPECT_EQ(NumOfInstructions(entry, HloOpcode::kAllToAll), 0);
+  EXPECT_EQ(NumOfInstructions(entry, HloOpcode::kCollectivePermute), 0);
+  EXPECT_THAT(
+      entry->root_instruction(),
+      AllOf(op::Shape("f32[1,2,16,16]"),
+            op::Add(op::Parameter(0),
+                    op::Broadcast(op::Reshape(op::Broadcast(op::DynamicSlice(
+                        op::Constant(), op::Reshape(), op::Constant(),
+                        op::Constant(), op::Constant())))))));
+}
+
+TEST_P(SpmdPartitioningTest, SingletonReshapeWithTiledSingletonDimsNoAllGather) {
+  absl::string_view hlo_string = R"(
+HloModule module
+
+ENTRY entry {
+  %param = f32[2,1,4] parameter(0), sharding={devices=[2,2,1]<=[4]}
+  ROOT %reshape = f32[2,4,1] reshape(%param), sharding={devices=[2,1,2]<=[4]}
+})";
+  ASSERT_OK_AND_ASSIGN(auto module,
+                       PartitionComputation(hlo_string, /*num_devices=*/4));
+  const HloComputation* entry = module->entry_computation();
+  // Dim 0 (size 2, sharded 2-way on both) should stay local without a full
+  // 4-device replicate; only the size-1 dims partially replicate/slice.
+  for (const HloInstruction* inst : entry->instructions()) {
+    if (inst->opcode() == HloOpcode::kAllReduce ||
+        inst->opcode() == HloOpcode::kAllGather) {
+      EXPECT_LE(ShapeUtil::ElementsIn(inst->shape()), 4);
+    }
+  }
+  EXPECT_THAT(entry->root_instruction(), op::Shape("f32[1,4,1]"));
+}
+
