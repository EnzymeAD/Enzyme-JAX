+std::optional<HloSharding> PropagateReshapeShardingInPreprocess(
+    const Shape& in_shape, const Shape& out_shape,
+    const HloSharding& op_sharding) {
+  if (op_sharding.IsTuple() || op_sharding.IsReplicated() ||
+      op_sharding.IsUnknown() || op_sharding.IsShardGroup()) {
+    return std::nullopt;
+  }
+  if (op_sharding.IsSingleDevice() || op_sharding.IsManual() ||
+      op_sharding.IsUnreduced()) {
+    return op_sharding;
+  }
+  if (!in_shape.is_static() || !out_shape.is_static()) {
+    return std::nullopt;
+  }
+  absl::Span<const int64_t> in_dims = in_shape.dimensions();
+  absl::Span<const int64_t> out_dims = out_shape.dimensions();
+  int64_t in_rank = in_dims.size();
+  int64_t out_rank = out_dims.size();
+  std::vector<int64_t> src_to_tgt(in_rank, -1);
+  std::vector<int64_t> tgt_to_src(out_rank, -1);
+  int64_t i = 0;
+  int64_t j = 0;
+  bool is_singleton_reshape = true;
+  while (i < in_rank || j < out_rank) {
+    if (i < in_rank && j < out_rank && in_dims[i] == out_dims[j]) {
+      src_to_tgt[i] = j;
+      tgt_to_src[j] = i;
+      ++i;
+      ++j;
+    } else if (j < out_rank && out_dims[j] == 1) {
+      ++j;
+    } else if (i < in_rank && in_dims[i] == 1) {
+      ++i;
+    } else {
+      is_singleton_reshape = false;
+      break;
+    }
+  }
+  if (is_singleton_reshape) {
+    if (std::optional<HloSharding> mapped =
+            hlo_sharding_util::TransposeShardingWithCollapsedDims(
+                op_sharding, src_to_tgt, tgt_to_src)) {
+      return mapped;
+    }
+    if (!op_sharding.UseNamedShardingLeaf()) {
+      std::vector<int64_t> dropped_tiled_dims;
+      for (int64_t d = 0; d < in_rank; ++d) {
+        if (src_to_tgt[d] < 0 && op_sharding.dimension(d) > 1) {
+          dropped_tiled_dims.push_back(d);
+        }
+      }
+      if (!dropped_tiled_dims.empty()) {
+        HloSharding clean_op =
+            hlo_sharding_util::PartiallyReplicateTiledShardingOnDims(
+                op_sharding, dropped_tiled_dims);
+        return hlo_sharding_util::TransposeShardingWithCollapsedDims(
+            clean_op, src_to_tgt, tgt_to_src);
+      }
+    }
+  }
+  if (!op_sharding.UseNamedShardingLeaf()) {
+    return hlo_sharding_util::ReshapeSharding(in_shape, out_shape, op_sharding);
+  }
+  return std::nullopt;
+}
