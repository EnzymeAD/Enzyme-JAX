+// Decomposes `stablehlo.broadcast_in_dim` operations that expand size-1 operand
+// dimensions into a singleton-removing `stablehlo.reshape` followed by a
+// non-degenerate `stablehlo.broadcast_in_dim`, projecting Shardy shardings onto
+// the squeezed tensor so `XlaBuilder::BroadcastInDim` does not stamp the
+// broadcast result's tiled sharding onto degenerate size-1 intermediate
+// dimensions.
+void decomposeDegenerateBroadcasts(mlir::ModuleOp moduleOp,
+                                   const SymbolTable& symbolTable) {
+  moduleOp.walk([&](stablehlo::BroadcastInDimOp bcastOp) {
+    auto inType = mlir::dyn_cast<mlir::RankedTensorType>(
+        bcastOp.getOperand().getType());
+    auto outType = mlir::dyn_cast<mlir::RankedTensorType>(bcastOp.getType());
+    if (!inType || !outType || !inType.hasStaticShape() ||
+        !outType.hasStaticShape()) {
+      return;
+    }
+    mlir::ArrayRef<int64_t> bcastDims = bcastOp.getBroadcastDimensions();
+    bool hasDegenerateDim = false;
+    mlir::SmallVector<int64_t> squeezedShape;
+    mlir::SmallVector<int64_t> keptBcastDims;
+    mlir::SmallVector<bool> keepInDim(bcastDims.size(), true);
+    for (auto [inDim, outDim] : llvm::enumerate(bcastDims)) {
+      int64_t inSize = inType.getDimSize(inDim);
+      int64_t outSize = outType.getDimSize(outDim);
+      if (inSize == 1 && outSize != 1) {
+        hasDegenerateDim = true;
+        keepInDim[inDim] = false;
+      } else {
+        squeezedShape.push_back(inSize);
+        keptBcastDims.push_back(outDim);
+      }
+    }
+    if (!hasDegenerateDim) {
+      return;
+    }
+
+    mlir::OpBuilder builder(bcastOp);
+    auto squeezedType =
+        mlir::RankedTensorType::get(squeezedShape, inType.getElementType());
+    auto squeezeOp = stablehlo::ReshapeOp::create(
+        builder, bcastOp.getLoc(), squeezedType, bcastOp.getOperand());
+
+    TensorShardingAttr squeezeSharding;
+    if (TensorShardingAttr inSharding =
+            mlir::sdy::getSharding(bcastOp.getOperand())) {
+      mlir::SmallVector<mlir::sdy::DimensionShardingAttr> dimShardings;
+      dimShardings.reserve(squeezedShape.size());
+      mlir::SmallVector<mlir::sdy::AxisRefAttr> newReplicatedAxes(
+          inSharding.getReplicatedAxes().begin(),
+          inSharding.getReplicatedAxes().end());
+      bool droppedShardedAxes = false;
+      for (int64_t inDim = 0; inDim < inType.getRank(); ++inDim) {
+        mlir::sdy::DimensionShardingAttr dimSharding =
+            inSharding.getDimSharding(inDim);
+        if (keepInDim[inDim]) {
+          dimShardings.push_back(dimSharding);
+        } else if (!dimSharding.emptyAxes()) {
+          newReplicatedAxes.append(dimSharding.getAxes().begin(),
+                                   dimSharding.getAxes().end());
+          droppedShardedAxes = true;
+        }
+      }
+      if (droppedShardedAxes) {
+        if (mlir::sdy::MeshAttr mesh = inSharding.getMesh(symbolTable)) {
+          mlir::sdy::sortAndMergeAxes(newReplicatedAxes, mesh);
+        } else {
+          newReplicatedAxes.assign(inSharding.getReplicatedAxes().begin(),
+                                   inSharding.getReplicatedAxes().end());
+        }
+      }
+      squeezeSharding = TensorShardingAttr::get(
+          bcastOp.getContext(), inSharding.getMeshOrRef(), dimShardings,
+          newReplicatedAxes, inSharding.getUnreducedAxes(),
+          inSharding.getReductionOp());
+    } else if (TensorShardingAttr outSharding =
+                   mlir::sdy::getSharding(bcastOp.getResult())) {
+      mlir::SmallVector<mlir::sdy::DimensionShardingAttr> dimShardings;
+      dimShardings.reserve(keptBcastDims.size());
+      for (int64_t outDim : keptBcastDims) {
+        dimShardings.push_back(outSharding.getDimSharding(outDim));
+      }
+      squeezeSharding = TensorShardingAttr::get(
+          bcastOp.getContext(), outSharding.getMeshOrRef(), dimShardings,
+          outSharding.getReplicatedAxes(), outSharding.getUnreducedAxes(),
+          outSharding.getReductionOp());
+    }
+    if (squeezeSharding) {
+      mlir::sdy::setShardings(squeezeOp, squeezeSharding);
+    }
+    if (mlir::Attribute manualAxes = bcastOp->getAttr(kManualAxes)) {
+      squeezeOp->setAttr(kManualAxes, manualAxes);
+    }
+
+    auto newBcastOp = stablehlo::BroadcastInDimOp::create(
+        builder, bcastOp.getLoc(), outType, squeezeOp,
+        builder.getDenseI64ArrayAttr(keptBcastDims));
+    newBcastOp->setDiscardableAttrs(bcastOp->getDiscardableAttrDictionary());
+    bcastOp.replaceAllUsesWith(newBcastOp.getResult());
+    bcastOp.erase();
+  });
+}
