+// CHECK:           tensor.insert {{.*}} : tensor<1x2x100xf32>
+// CHECK:         xla.loop
+// CHECK:           tensor.insert {{.*}} : tensor<1x2x100xf32>
+// CHECK:           tensor.insert {{.*}} : tensor<1x2x100xf32>
+// CHECK-NOT:     xla.loop
