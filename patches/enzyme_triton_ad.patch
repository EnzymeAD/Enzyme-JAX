     return batchType(self, width);
   }
 
-  bool isMutable(Type self) const { return false; }
+  bool isMutable(Type self) const {
+    // A tensor of memory handles carries handles to shadow memory, not an
+    // additive tensor adjoint. This also lets reverse-mode cloning reserve
+    // shadow block arguments and placeholders before visiting their users.
+    auto element = dyn_cast<AutoDiffTypeInterface>(
+        cast<TensorType>(self).getElementType());
+    return element && element.isMutable();
+  }
   LogicalResult zeroInPlace(Type self, OpBuilder &builder, Location loc,
