diff --git a/Enzyme/MLIR/Implementations/CoreDialectsAutoDiffImplementations.cpp b/Enzyme/MLIR/Implementations/CoreDialectsAutoDiffImplementations.cpp
--- a/Enzyme/MLIR/Implementations/CoreDialectsAutoDiffImplementations.cpp
+++ b/Enzyme/MLIR/Implementations/CoreDialectsAutoDiffImplementations.cpp
@@ -491,6 +491,42 @@
     if (!gutils->isConstantValue(res))
       resultPositionsToShadow.insert(res.getResultNumber());
 
+  // A terminator can forward the same operand both to a loop backedge and
+  // to an unused parent result. Its shadow is still required by the backedge,
+  // and the parent result signature must retain that slot as well.
+  for (Region &region : op->getRegions()) {
+    for (Block &block : region) {
+      auto term =
+          dyn_cast<RegionBranchTerminatorOpInterface>(block.getTerminator());
+      if (!term)
+        continue;
+      SmallVector<RegionSuccessor> successors;
+      term.getSuccessorRegions(
+          SmallVector<Attribute>(term->getNumOperands(), Attribute()),
+          successors);
+      llvm::SmallDenseSet<unsigned> shadowed;
+      for (const auto &successor : successors) {
+        OperandRange operands = term.getSuccessorOperands(successor);
+        ValueRange targets = successor.isOperation()
+                                 ? op->getResults()
+                                 : regionBranchOp.getSuccessorInputs(successor);
+        for (auto [i, target] : llvm::enumerate(
+                 targets.take_front(std::min(targets.size(), operands.size()))))
+          if (!gutils->isConstantValue(target))
+            shadowed.insert(operands.getBeginOperandIndex() + i);
+      }
+      for (const auto &successor : successors) {
+        if (!successor.isOperation())
+          continue;
+        OperandRange operands = term.getSuccessorOperands(successor);
+        for (unsigned i = 0;
+             i < std::min<size_t>(operands.size(), op->getNumResults()); ++i)
+          if (shadowed.contains(operands.getBeginOperandIndex() + i))
+            resultPositionsToShadow.insert(i);
+      }
+    }
+  }
+
   return controlFlowForwardHandler(
       op, builder, gutils, operandPositionsToShadow, resultPositionsToShadow);
 }
