   LogicalResult createShadowValues(Operation *op, OpBuilder &builder,
                                    MGradientUtilsReverse *gutils) const {
-    // auto forOp = cast<scf::ForOp>(op);
+    auto forOp = cast<scf::ForOp>(op);
