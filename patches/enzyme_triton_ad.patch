+    bool any = false;
+    for (auto arg : forOp.getRegionIterArgs()) {
+      bool shadow = !gutils->isConstantValue(arg) &&
+                    cast<AutoDiffTypeInterface>(arg.getType()).isMutable();
+      shadowed.push_back(shadow);
+      any |= shadow;
+    }
+    if (!any)
+      return success();
+
+    auto newOp = cast<scf::ForOp>(gutils->getNewFromOriginal(op));
+    SmallVector<Value> inits;
+    for (auto [arg, shadow] : llvm::zip_equal(forOp.getInitArgs(), shadowed)) {
+      inits.push_back(gutils->getNewFromOriginal(arg));
+      if (shadow)
+        inits.push_back(gutils->isConstantValue(arg)
+                            ? gutils->getNewFromOriginal(arg)
+                            : gutils->invertPointerM(arg, builder));
+    }
+    auto replacement =
+        scf::ForOp::create(builder, op->getLoc(), newOp.getLowerBound(),
+                           newOp.getUpperBound(), newOp.getStep(), inits);
+    preserveAttributesButCheckpointing(replacement, forOp);
+    replacement.getRegion().takeBody(newOp.getRegion());
+    SmallVector<Value> yields;
+    auto oldYield = forOp.getBody()->getTerminator();
+    for (auto [arg, shadow] :
+         llvm::zip_equal(oldYield->getOperands(), shadowed)) {
+      yields.push_back(gutils->getNewFromOriginal(arg));
+      if (shadow)
+        yields.push_back(gutils->isConstantValue(arg)
+                             ? gutils->getNewFromOriginal(arg)
+                             : gutils->invertPointerM(arg, builder));
+    }
+    replacement.getBody()->getTerminator()->setOperands(yields);
+    SmallVector<Value> results;
+    unsigned index = 0;
+    for (auto [result, shadow] :
+         llvm::zip_equal(forOp.getResults(), shadowed)) {
+      results.push_back(replacement.getResult(index++));
+      if (shadow) {
+        if (!gutils->isConstantValue(result))
+          gutils->setInvertedPointer(result, replacement.getResult(index));
+        ++index;
+      }
+    }
+    gutils->replaceOrigOpWith(op, results);
+    gutils->erase(newOp);
+    gutils->originalToNewFn.map(op, replacement.getOperation());
     return success();
   }
