-    const MachineRegisterInfo &MRI = MF->getRegInfo();
-    IsNullOrVectorRegister = !RI.isSGPRClass(RI.getRegClassForReg(MRI, Reg));
-  }
-
-  return IsNullOrVectorRegister &&
-         (canAddToBBProlog(MI) ||
-          (!MI.isTerminator() && MI.getOpcode() != AMDGPU::COPY &&
